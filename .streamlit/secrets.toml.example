# TEMPLATE ONLY - copy into the Streamlit Cloud app's Secrets box (Settings -> Secrets).
# Never commit real values: .streamlit/secrets.toml is gitignored. See dashboard_access.py.

[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "LONG-RANDOM-STRING"
client_id = "YOUR-GOOGLE-OAUTH-CLIENT-ID"
client_secret = "YOUR-GOOGLE-OAUTH-CLIENT-SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[access]
admins = ["you@example.com"]
pro = ["customer1@example.com", "customer2@example.com"]
