# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Large data files (stay local)
data/
*.zip
*.xlsx

# Model pkl files — included so GitHub Actions can run predict
# *.pkl  ← removed from ignore so models are committed

# Logs
*.log
scheduler/logs/

# Secrets
.streamlit/secrets.toml

# NOT ignored (2026-08-15): odds_history_v9.json. It was listed under "Secrets" but holds no
# secret — only O/U price snapshots. Ignoring it meant CI started every predict run with an
# empty history, so drift_signal was permanently "New" and over/under_drift permanently 0.0.
# drift.py now stores only price CHANGES, which keeps it small enough to commit each run.

# Keep output CSVs (needed by Streamlit Cloud)
!output/bets.csv
!output/bets_ledger.csv
!output/backtest_results_standard.csv
!output/backtest_by_league_standard.csv
!output/backtest_season_breakdown.csv
!output/predictions.csv
!models/feature_importances_standard.csv
!models/feature_importances_newformat.csv
