# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Large data files (stay local)
data/
*.zip
*.xlsx

# Model pkl files — included so GitHub Actions can run predict
# *.pkl  ← removed from ignore so models are committed

# Logs
*.log
scheduler/logs/

# Secrets
.streamlit/secrets.toml

# NOT ignored (2026-08-15): odds_history_v9.json. It was listed under "Secrets" but holds no
# secret — only O/U price snapshots. Ignoring it meant CI started every predict run with an
# empty history, so drift_signal was permanently "New" and over/under_drift permanently 0.0.
# drift.py now stores only price CHANGES, which keeps it small enough to commit each run.

# Keep output CSVs (needed by Streamlit Cloud)
!output/bets.csv
!output/bets_ledger.csv
!output/backtest_results_standard.csv
!output/backtest_by_league_standard.csv
!output/backtest_season_breakdown.csv
!output/predictions.csv
!models/feature_importances_standard.csv
!models/feature_importances_newformat.csv
# Player model caches — regeneratable, too large for git
fixture_player_cache/
player_match_cache/

# Secrets - keep locally only
telegram_bot/bot_config.json
.api_keys
.env

# API-Football response cache — regeneratable, too large for git
api_football_cache/

# Player prop caches — regeneratable, not needed in git
fixture_stats_cache/
prop_odds_cache/
# Not covered by api_football_cache/ above — the name differs (no underscore after "api").
# 44,453 untracked files were sitting here unignored; nothing under it is tracked, so adding
# this un-tracks nothing and cannot produce a renormalisation diff.
apifootball_ou_cache/

# The last three prop caches that were never listed here (found 2026-09-24). 15,330 untracked
# files — 11,049 + 4,277 + 4 — that a single `git add -A` would have committed. Verified with
# `git ls-files` that NOTHING under any of them is tracked, so adding these un-tracks nothing
# and cannot produce the renormalisation diff that broke v9's push loop on 2026-08-19.
fixture_events_cache/
player_season_stats_cache/
lineup_cache/

# Dashboard remote-read cache: fetched copies of Pro/v11 output when they are not checked
# out beside v9. Regenerable and per-deploy, so it must never be committed.
dashboard_data/_remote_cache/

# SHADOW contract-violation log (src/contracts/shadow.py, 2026-10-25). Runner-local by design: predict,
# daily_summary and evidence_refresh all write it, and a tracked file that a job modifies without
# committing is the shape of the 2026-09 rebase incident. Blast radius: exactly this one path, which
# no commit has ever tracked (git ls-files output/contract_violations.json* is empty). The committed
# summary lives in output/system_health.json.
output/contract_violations.json
output/contract_violations.json.tmp

# PRIVATE PRICES (owner 2026-11-24, "so fix it! especially the public odds"). Class A/O price files live
# ONLY in the private store NevixAA/wowza-exec, branch af-prices-live, at wowza-betting/main/<path>
# (config/price_store_paths.json "live" / "public_retired"). Jobs place them here with
# scripts/price_store_live.sh open and write them back with push; a pre-commit hook keeps them out of
# every public commit and Data truth 17 fails a commit that tracks one again.
/odds_history_v9.json
/output/book_odds_snapshots.csv
/output/book_odds_snapshots_archive/
/output/book_quotes/
/output/exchange_quotes/
/output/newformat_odds_dense.csv
/output/newformat_odds_history.csv
/output/odds_heartbeat/
/output/player_prop_odds_history.csv
/output/player_prop_odds_history_archive/
/output/prop_quotes/
/output/sharp_history/
/output/specials_quotes/
/output/standard_odds_history.csv
/output/standard_sidemarket_odds_history.csv
/output/worldcup_history.json
